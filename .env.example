# Docker data directory (used internally, do not change)
DATA_DIR=/data

# Absolute host path to the directory mounted as /workspace in Docker.
# Required for "Open in VS Code" to resolve container paths to host paths.
# Example: /home/user/projects or C:\Users\user\projects
WORKSPACE_HOST_PATH=./projects

# Absolute host path to the directory mounted as /data/profiles in Docker.
# Allows editing Claude profiles directly from the host filesystem.
# Example: /home/user/.claude-profiles or C:\Users\user\.claude-profiles
PROFILES_HOST_PATH=./profiles
